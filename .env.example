# Orchestrator
ORCHESTRATOR_URL=http://localhost:8000

# Slack — copy from https://api.slack.com/apps/<your-app>
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=<signing-secret>

# Routing
# ROUTING_MODE options: keyword | llm | hybrid  (default: hybrid)
ROUTING_MODE=hybrid
# ROUTING_CONFIDENCE_THRESHOLD: float [0.0, 1.0] — used in hybrid mode only.
# If keyword score >= threshold the LLM call is skipped.  (default: 0.3)
ROUTING_CONFIDENCE_THRESHOLD=0.3
# ANTHROPIC_API_KEY: required for llm and hybrid modes.
ANTHROPIC_API_KEY=sk-ant-...
