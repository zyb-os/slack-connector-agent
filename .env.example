# slack-connector-agent — environment configuration
#
# !! SECRETS DO NOT BELONG HERE !!
# Slack tokens and signing secret must be set through the orchestrator dashboard:
#   http://<orchestrator>:8000  →  Agents  →  slack-connector  →  ⚙ Settings
#   Required:  slack_bot_token · slack_app_token · slack_signing_secret
#
# If using LLM or hybrid routing, set the Anthropic API key in common settings:
#   http://<orchestrator>:8000  →  Common Settings  →  anthropic_api_key
#
# This file contains only non-secret infrastructure configuration.

# Orchestrator endpoint
ORCHESTRATOR_URL=http://localhost:8000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Routing mode: keyword | llm | hybrid  (default: hybrid)
ROUTING_MODE=hybrid

# Confidence threshold for hybrid routing [0.0 – 1.0]
ROUTING_CONFIDENCE_THRESHOLD=0.3
